# Copy this file to .env. With no key the app runs in mock mode (recorded responses, no cost).
ANTHROPIC_API_KEY=

# Force mock mode even when a key is present (useful for demos without internet).
# LLM_MODE=mock

# Model and pricing (USD per million tokens). Check current prices before trusting the cost panel.
LLM_MODEL=claude-haiku-4-5-20251001
PRICE_INPUT_PER_MTOK=1
PRICE_OUTPUT_PER_MTOK=5

# Suggestions below this confidence go to human review.
CONFIDENCE_THRESHOLD=0.8

# Throughput and resilience knobs.
BATCH_SIZE=20
CONCURRENCY=3
LLM_TIMEOUT_MS=20000
PORT=3001
